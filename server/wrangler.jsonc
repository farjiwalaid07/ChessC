{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chesscrazy-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "ChessRoom"
      }
    ]
  },
  "exports": {
    "ChessRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
